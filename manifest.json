{
  "manifest_version": 3,
  "name": "Jev × WebMCP",
  "version": "0.1.0",
  "description": "Type what you want. Jev picks the page's WebMCP tool and fills its arguments in a couple hundred milliseconds.",
  "minimum_chrome_version": "149",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Jev × WebMCP", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": ["*://*/*"]
}
